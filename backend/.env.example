# OpenWeatherMap API Key (Get a free key from https://openweathermap.org/api)
# If left blank or invalid, the backend will gracefully use seasonal/hourly weather fallbacks.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Path to the trained ML model artifact (default points to notebooks/)
MODEL_PATH=../notebooks/delivery_time_predictor.pkl

# External API endpoints (free, open source)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
HTTP_TIMEOUT=4.0
